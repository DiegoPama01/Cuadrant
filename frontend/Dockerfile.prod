FROM node:22-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --global npm@11.6.2 \
    && npm ci --no-audit

COPY . .

ARG FRONTEND_PUBLIC_API_BASE_URL
ARG FRONTEND_PUBLIC_AUTH_ENABLED
ARG FRONTEND_PUBLIC_AUTH_ISSUER_URL
ARG FRONTEND_PUBLIC_AUTH_CLIENT_ID
ARG FRONTEND_PUBLIC_AUTH_REDIRECT_URI
ARG FRONTEND_PUBLIC_AUTH_POST_LOGOUT_REDIRECT_URI
ARG FRONTEND_PUBLIC_AUTH_SCOPES
ARG FRONTEND_PUBLIC_AUTH_RESPONSE_TYPE

ENV FRONTEND_PUBLIC_API_BASE_URL=${FRONTEND_PUBLIC_API_BASE_URL} \
    FRONTEND_PUBLIC_AUTH_ENABLED=${FRONTEND_PUBLIC_AUTH_ENABLED} \
    FRONTEND_PUBLIC_AUTH_ISSUER_URL=${FRONTEND_PUBLIC_AUTH_ISSUER_URL} \
    FRONTEND_PUBLIC_AUTH_CLIENT_ID=${FRONTEND_PUBLIC_AUTH_CLIENT_ID} \
    FRONTEND_PUBLIC_AUTH_REDIRECT_URI=${FRONTEND_PUBLIC_AUTH_REDIRECT_URI} \
    FRONTEND_PUBLIC_AUTH_POST_LOGOUT_REDIRECT_URI=${FRONTEND_PUBLIC_AUTH_POST_LOGOUT_REDIRECT_URI} \
    FRONTEND_PUBLIC_AUTH_SCOPES=${FRONTEND_PUBLIC_AUTH_SCOPES} \
    FRONTEND_PUBLIC_AUTH_RESPONSE_TYPE=${FRONTEND_PUBLIC_AUTH_RESPONSE_TYPE}

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html

EXPOSE 80
