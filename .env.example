# Django
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-production-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=198.244.150.237,api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# PostgreSQL remota
# Si la base de datos solo es accesible por SSH, abre antes un tunel como:
# ssh -N -L 5432:127.0.0.1:5432 ubuntu@198.244.150.237
DATABASE_URL=postgresql://cuadrant_user:change-me-db-password@127.0.0.1:5432/cuadrant_db?sslmode=require&connect_timeout=5&conn_max_age=60
POSTGRES_DB=cuadrant_db
POSTGRES_USER=cuadrant_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=5

# Authentik backend
AUTHENTIK_ENABLED=true
AUTHENTIK_ISSUER_URL=https://auth.diebyte.dev/application/o/cuadrant/
# Optional local Docker transport URL; leave empty in production.
AUTHENTIK_INTERNAL_URL=
AUTHENTIK_DISCOVERY_URL=
AUTHENTIK_JWKS_URL=
AUTHENTIK_CLIENT_ID=cuadrant
AUTHENTIK_CLIENT_SECRET=change-me-authentik-client-secret
AUTHENTIK_SERVICE_TOKEN=change-me-authentik-service-token
AUTHENTIK_DEFAULT_GROUPS=quadrant-users
AUTHENTIK_DEFAULT_GROUP_IDS=
AUTHENTIK_AUDIENCE=
AUTHENTIK_SCOPES=openid profile email
AUTHENTIK_SUB_CLAIM=sub
AUTHENTIK_EMAIL_CLAIM=email
AUTHENTIK_USERNAME_CLAIM=preferred_username
AUTHENTIK_VERIFY_SSL=true

# OpenFGA
OPENFGA_ENABLED=true
OPENFGA_API_URL=https://openfga.example.com
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
OPENFGA_API_TOKEN=
OPENFGA_TIMEOUT_SECONDS=5
OPENFGA_PROJECT_OBJECT=project:cuadrant

# Frontend public runtime config
FRONTEND_PUBLIC_API_BASE_URL=https://api.example.com/api
FRONTEND_PUBLIC_AUTH_ENABLED=true
FRONTEND_PUBLIC_AUTH_ISSUER_URL=https://auth.diebyte.dev/application/o/cuadrant/
FRONTEND_PUBLIC_AUTH_CLIENT_ID=cuadrant
FRONTEND_PUBLIC_AUTH_REDIRECT_URI=https://app.example.com/auth/callback
FRONTEND_PUBLIC_AUTH_POST_LOGOUT_REDIRECT_URI=https://app.example.com/login
FRONTEND_PUBLIC_AUTH_SCOPES=openid profile email
FRONTEND_PUBLIC_AUTH_RESPONSE_TYPE=code
